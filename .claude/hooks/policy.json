{
  "schema_version": 2,
  "source_globs": [
    "*.sh",
    "**/*.sh",
    "*.py",
    "**/*.py",
    ".github/workflows/*.yml",
    ".gitea/workflows/*.yml",
    "*.rb",
    "**/*.rb",
    "*.erb",
    "**/*.erb",
    "*.js",
    "**/*.js",
    "*.css",
    "**/*.css",
    "Gemfile",
    "Rakefile",
    "*.gemspec",
    "bin/*",
    "config.ru",
    "Dockerfile",
    "config/*.yml",
    "config/**/*.yml"
  ],
  "test_globs": [
    "test/**",
    "tests/**",
    "spec/**",
    "**/*_test.py",
    "**/*_test.exs",
    "**/*_spec.rb",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "**/*.test.jsx",
    "**/*.spec.jsx",
    "features/**",
    "support/coverage.rb",
    "script/coverage.rb"
  ]
}
